{
  "name": "mysql-shop-connector",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "tasks.max": "1",
    "database.hostname": "mysql",
    "database.port": "3306",
    "database.user": "debezium",
    "database.password": "dbz",
    "database.server.id": "5401",
    "database.connectionTimeZone": "UTC",
    "topic.prefix": "mysql",
    "database.include.list": "shop",
    "table.include.list": "shop.orders,shop.customers",
    "snapshot.mode": "initial",
    "snapshot.locking.mode": "minimal",
    "include.schema.changes": "true",
    "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
    "schema.history.internal.kafka.topic": "schema-history.shop",
    "schema.history.internal.store.only.captured.tables.ddl": "false",
    "heartbeat.interval.ms": "10000",
    "heartbeat.action.query": "INSERT INTO shop.dbz_heartbeat (id, updated_at) VALUES (1, NOW(3)) ON DUPLICATE KEY UPDATE updated_at = VALUES(updated_at)",
    "provide.transaction.metadata": "true",
    "tombstones.on.delete": "true",
    "decimal.handling.mode": "string",
    "binary.handling.mode": "base64",
    "time.precision.mode": "isostring",
    "errors.retry.timeout": "-1",
    "errors.retry.delay.max.ms": "60000",
    "errors.log.enable": "true",
    "errors.log.include.messages": "false",
    "topic.creation.enable": "true",
    "topic.creation.default.replication.factor": "1",
    "topic.creation.default.partitions": "3",
    "topic.creation.default.cleanup.policy": "delete",
    "topic.creation.default.retention.ms": "604800000",
    "errors.max.retries": "-1"
  }
}
